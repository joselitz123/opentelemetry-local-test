# OpenTelemetry Configuration
# Copy this file to .env and fill in your actual Grafana Cloud credentials

# Grafana Cloud OTLP Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-grafana-cloud-instance:4318

# Grafana Cloud Authentication Token
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-grafana-cloud-token

# Service Configuration
OTEL_SERVICE_NAME=opentelemetry-demo
OTEL_RESOURCE_ATTRIBUTES=service.name=opentelemetry-demo,deployment.environment=demo

# Exporter Configuration
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=15000
